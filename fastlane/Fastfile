default_platform(:android)

platform :android do

  private_lane :increment_version do |options|
     puts "increments versions #{options}"
     android_set_version_code(
       gradle_file: "app/build.gradle.kts",
       version_code: options[:version_code]
     )
  end

  desc "Run unit tests"
  lane :test do
    gradle(task: "testDevDebugUnitTest")
  end

  desc "Run UI tests (requires a connected device or emulator)"
  lane :ui_test do
    gradle(
      task: "assembleDevDebug assembleDevDebugAndroidTest"
    )
    pwd
    sh("gcloud firebase test android run --type instrumentation --app app/build/outputs/apk/dev/debug/app-dev-debug.apk --test app/build/outputs/apk/androidTest/dev/debug/app-dev-debug-androidTest.apk --device model=oriole,version=33,locale=en,orientation=portrait")
  end

  desc "Submit a new Dev Build to Firebase App Distribution"
  lane :distribute_dev do
    # 0. Run tests
    test
    # ui_test # Uncomment this if you want to run UI tests automatically (requires device)
    ui_test
    # 1. Get the latest build number from Firebase
    latest_release = firebase_app_distribution_get_latest_release(
           app: ENV["FIREBASE_APP_ID_DEV"]
         )
    latest_build_number = latest_release[:buildVersion].to_i
    UI.message("latest_release on Firebase: #{latest_release}")
    UI.message("Latest Build ID on Firebase: #{latest_build_number}")

    # 2. Increment
    new_build_number = latest_build_number + 1
    UI.message("Next Build ID: #{new_build_number}")

    # 3. Update local build.gradle.kts (optional, but requested via increment_version)
    increment_version(version_code: new_build_number)

    gradle(
      task: "assembleDevRelease",
      properties: {
        "android.injected.versionCode" => new_build_number
      }
    )

    firebase_app_distribution(
      app: ENV["FIREBASE_APP_ID_DEV"],
      apk_path: "app/build/outputs/apk/dev/release/app-dev-release.apk",
      groups: "testers",
      release_notes: "Dev build #{new_build_number} from Fastlane"
    )
  end

  desc "Submit a new QA Build to Firebase App Distribution"
  lane :distribute_qa do

        latest_release = firebase_app_distribution_get_latest_release(
               app: ENV["FIREBASE_APP_ID_QA"]
             )
        latest_build_number = latest_release[:buildVersion].to_i
        UI.message("latest_release on Firebase: #{latest_release}")
        UI.message("Latest Build ID on Firebase: #{latest_build_number}")

        # 2. Increment
        new_build_number = latest_build_number + 1
        UI.message("Next Build ID: #{new_build_number}")

        # 3. Update local build.gradle.kts (optional, but requested via increment_version)
        increment_version(version_code: new_build_number)


    gradle(task: "assembleQaDebug")

    firebase_app_distribution(
      app: ENV["FIREBASE_APP_ID_QA"],
      apk_path: "app/build/outputs/apk/qa/release/app-qa-release.apk",
      groups: "testers",
      release_notes: "QA build from Fastlane"
    )
  end

  desc "Submit a new Prod Build to Firebase App Distribution"
  lane :distribute_prod do

        latest_release = firebase_app_distribution_get_latest_release(
               app: ENV["FIREBASE_APP_ID_PROD"]
             )
        latest_build_number = latest_release[:buildVersion].to_i
        UI.message("latest_release on Firebase: #{latest_release}")
        UI.message("Latest Build ID on Firebase: #{latest_build_number}")

        # 2. Increment
        new_build_number = latest_build_number + 1
        UI.message("Next Build ID: #{new_build_number}")

        # 3. Update local build.gradle.kts (optional, but requested via increment_version)
        increment_version(version_code: new_build_number)


    gradle(task: "assembleProdRelease")

    firebase_app_distribution(
      app: ENV["FIREBASE_APP_ID_PROD"],
      apk_path: "app/build/outputs/apk/prod/release/app-prod-release.apk",
      groups: "testers",
      release_notes: "Prod release build from Fastlane"
    )
  end
end
